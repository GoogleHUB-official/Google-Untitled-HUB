        if not myHrp or not targetHrp then return end

        local originalCF = myHrp.CFrame
        Notify("Kill", "Attempting Void Kill on " .. selectedTargetPlayer.Name .. "...", 3)

        local couchTool = getCoachCouchTool()
        if couchTool and couchTool.Parent == LocalPlayer:FindFirstChildOfClass("Backpack") then
            couchTool.Parent = char
        end

        task.spawn(function()
            myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 2)
            task.wait(0.35)
            
            myHrp.CFrame = CFrame.new(0, -500, 0)
            task.wait(0.4)

            if couchTool and couchTool.Parent == char then
                couchTool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
            end

            task.wait(0.2)
            myHrp.CFrame = originalCF
            Notify("Kill", "Target dropped into Void!", 2.5)
        end)
    end)

    -- ------------------------------------------
    -- 3. ПОЛНОЦЕННЫЙ МОДУЛЬ ESP (BROOKHAVEN)
    -- ------------------------------------------
    CreateHeader(TabESP, "-[ Players ]-")

    local espPlayerBox = false
    local espPlayerName = false
    local espPlayerDistance = false
    local espPlayerItem = false

    CreateToggle(TabESP, "Player Box ESP", false, function(s) espPlayerBox = s end)
    CreateToggle(TabESP, "Name ESP", false, function(s) espPlayerName = s end)
    CreateToggle(TabESP, "Distance ESP", false, function(s) espPlayerDistance = s end)
    CreateToggle(TabESP, "Item ESP (Tool in hand)", false, function(s) espPlayerItem = s end)

    CreateHeader(TabESP, "-[ Other ]-")

    local espSkeleton = false
    local espLookVector = false
    local espWallCheck = false
    local espFriendHighlight = false

    CreateToggle(TabESP, "Skeleton ESP", false, function(s) espSkeleton = s end)
    CreateToggle(TabESP, "Look Vector Line", false, function(s) espLookVector = s end)
    CreateToggle(TabESP, "Wall Check (Green/Red)", false, function(s) espWallCheck = s end)
    CreateToggle(TabESP, "Friend ESP (Priority Frame)", false, function(s) espFriendHighlight = s end)

    -- РЕНДЕРИНГ БРУКХЕЙВЕН ESP
    local drawCache = {}

    local function getDraw(key, drawType)
        if not drawCache[key] then
            local success, obj = pcall(function() return Drawing.new(drawType) end)
            if success and obj then
                drawCache[key] = obj
            end
        end
        return drawCache[key]
    end

    local function clearAllDrawings()
        for _, obj in pairs(drawCache) do
            pcall(function()
                obj.Visible = false
                obj:Remove()
            end)
        end
        table.clear(drawCache)
    end

    RunService.RenderStepped:Connect(function()
        if game.PlaceId ~= BROOKHAVEN_PLACE_ID then return end

        local cam = Workspace.CurrentCamera
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
                local char = pl.Character
                local hrp = char.HumanoidRootPart
                local head = char:FindFirstChild("Head")

                local isFriend = false
                if espFriendHighlight then
                    pcall(function()
                        isFriend = LocalPlayer:IsFriendsWith(pl.UserId)
                    end)
                end

                local isVisible = true
                if espWallCheck and head then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.FilterDescendantsInstances = {myChar, char}
                    local result = Workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, rayParams)
                    if result then isVisible = false end
                end

                local color = isFriend and Color3.fromRGB(255, 215, 0) or (isVisible and Color3.fromRGB(52, 168, 83) or Color3.fromRGB(234, 67, 53))

                local hrpPos, onScreen = cam:WorldToViewportPoint(hrp.Position)

                -- 1. BOX ESP
                local boxDraw = getDraw(pl.Name .. "_Box", "Square")
                if boxDraw then
                    if espPlayerBox and onScreen then
                        local headPos = head and cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or hrpPos
                        local height = math.abs(hrpPos.Y - headPos.Y) * 2.5
                        local width = height * 0.65

                        boxDraw.Size = Vector2.new(width, height)
                        boxDraw.Position = Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2)
                        boxDraw.Color = color
                        boxDraw.Thickness = isFriend and 2.5 or 1.5
                        boxDraw.Filled = false
                        boxDraw.Visible = true
                    else
                        boxDraw.Visible = false
                    end
                end

                -- 2. TEXT ESP (Name, Distance, Item)
                local textDraw = getDraw(pl.Name .. "_Text", "Text")
                if textDraw then
                    if (espPlayerName or espPlayerDistance or espPlayerItem) and onScreen then
                        local labelText = ""
                        if espPlayerName then labelText = labelText .. pl.DisplayName end
                        if espPlayerDistance and myHrp then
                            local dist = math.floor((hrp.Position - myHrp.Position).Magnitude)
                            labelText = labelText .. " [" .. dist .. "m]"
                        end
                        if espPlayerItem then
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then
                                labelText = labelText .. "\nItem: " .. tool.Name
                            end
                        end

                        textDraw.Text = labelText
                        textDraw.Position = Vector2.new(hrpPos.X, hrpPos.Y + 20)
                        textDraw.Color = color
                        textDraw.Size = 13
                        textDraw.Center = true
                        textDraw.Outline = true
                        textDraw.Visible = true
                    else
                        textDraw.Visible = false
                    end
                end

                -- 3. LOOK VECTOR LINE
                local lookDraw = getDraw(pl.Name .. "_Look", "Line")
                if lookDraw then
                    if espLookVector and head and onScreen then
                        local startPos = cam:WorldToViewportPoint(head.Position)
                        local endPos = cam:WorldToViewportPoint(head.Position + (head.CFrame.LookVector * 6))
                        lookDraw.From = Vector2.new(startPos.X, startPos.Y)
                        lookDraw.To = Vector2.new(endPos.X, endPos.Y)
                        lookDraw.Color = Color3.fromRGB(251, 188, 5)
                        lookDraw.Thickness = 1.5
                        lookDraw.Visible = true
                    else
                        lookDraw.Visible = false
                    end
                end

                -- 4. SKELETON ESP
                if espSkeleton then
                    local joints = {
                        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
                        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
                        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
                        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
                        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
                    }

                    for i, pair in ipairs(joints) do
                        local lineDraw = getDraw(pl.Name .. "_Skel_" .. i, "Line")
                        if lineDraw then
                            local p1 = char:FindFirstChild(pair[1])
                            local p2 = char:FindFirstChild(pair[2])
                            if p1 and p2 then
                                local v1, vis1 = cam:WorldToViewportPoint(p1.Position)
                                local v2, vis2 = cam:WorldToViewportPoint(p2.Position)
                                if vis1 and vis2 then
                                    lineDraw.From = Vector2.new(v1.X, v1.Y)
                                    lineDraw.To = Vector2.new(v2.X, v2.Y)
                                    lineDraw.Color = color
                                    lineDraw.Thickness = 1.2
                                    lineDraw.Visible = true
                                else
                                    lineDraw.Visible = false
                                end
                            else
                                lineDraw.Visible = false
                            end
                        end
                    end
                else
                    for i = 1, 10 do
                        local lineDraw = drawCache[pl.Name .. "_Skel_" .. i]
                        if lineDraw then lineDraw.Visible = false end
                    end
                end
            end
        end
    end)
end
