local currentGenIdx = 1
CreateButton(TabYou, "Teleport to Next Generator / Valve", function()
    local activeGenerators = getActiveGeneratorList()

    if #activeGenerators == 0 then
        Notify("Teleport", "No active generators or valves left on the map!", 2.5)
        return
    end

    if currentGenIdx > #activeGenerators then currentGenIdx = 1 end
    local targetGen = activeGenerators[currentGenIdx]

    local targetPart = targetGen:IsA("Model") and (targetGen.PrimaryPart or targetGen:FindFirstChildWhichIsA("BasePart")) or targetGen
    local prompt = targetGen:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
        targetPart = prompt.Parent
    end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if targetPart and hrp then
        local spawnPos = targetPart.CFrame * CFrame.new(0, 2, -3.5)
        hrp.CFrame = CFrame.lookAt(spawnPos.Position, targetPart.Position)
        
        Notify("Teleport", "Teleported to Generator / Valve #" .. currentGenIdx .. " / " .. #activeGenerators, 2)
        currentGenIdx = currentGenIdx + 1
    end
end)

