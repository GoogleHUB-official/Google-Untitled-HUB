    if idleConnection then idleConnection:Disconnect() end
    local time = 0
    idleConnection = RunService.RenderStepped:Connect(function(dt)
        if not isOpen then
            time = time + dt
            local floatY = math.sin(time * 2.5) * 4
            local swayRot = math.cos(time * 2) * 3
            LogoBtn.Position = UDim2.new(0.5, -17, 0.93, -17 + floatY)
            LogoBtn.Rotation = currentRotation + swayRot
        end
    end)
end

startIdle()

