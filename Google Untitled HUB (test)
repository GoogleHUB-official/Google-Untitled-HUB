    local autoElevatorEnabled = false
    local teleportedElevatorThisFloor = false

    local function checkAllGeneratorsDone()
        local generators = getGeneratorList()
        local totalGens = #generators
        if totalGens == 0 then return 0, 0 end

        local completedGens = 0
        for _, gen in ipairs(generators) do
            if isGeneratorCompleted(gen) then
                completedGens = completedGens + 1
            end
        end

        return totalGens, completedGens
    end

    local function findElevatorObject()
        local bestElevator = nil
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local nameLower = string.lower(obj.Name)
                if string.find(nameLower, "elevator") or string.find(nameLower, "lift") then
                    local parentName = obj.Parent and string.lower(obj.Parent.Name) or ""
                    if not (string.find(parentName, "elevator") or string.find(parentName, "lift")) then
                        if obj:IsA("Model") then
                            return obj
                        elseif not bestElevator then
                            bestElevator = obj
                        end
                    end
                end
            end
        end
        return bestElevator
    end

    local function getElevatorTargetPart(elevator)
        if not elevator then return nil end
        if elevator:IsA("BasePart") then return elevator end
        
        if elevator.PrimaryPart then return elevator.PrimaryPart end
        
        local preferredNames = {"floor", "base", "platform", "center", "main", "door", "spawn"}
        for _, child in pairs(elevator:GetDescendants()) do
            if child:IsA("BasePart") then
                local cName = string.lower(child.Name)
                for _, pref in ipairs(preferredNames) do
                    if string.find(cName, pref) then
                        return child
                    end
                end
            end
        end
        
        return elevator:FindFirstChildWhichIsA("BasePart", true)
    end

    task.spawn(function()
        while task.wait(1) do
            if autoElevatorEnabled and not teleportedElevatorThisFloor then
                local total, completed = checkAllGeneratorsDone()
                if total > 0 and completed == total then
                    teleportedElevatorThisFloor = true
                    Notify("Auto Elevator", "All generators finished! Waiting 4s for elevator to load...", 4)
                    
                    task.wait(4)

                    local elevator = findElevatorObject()
                    
                    if elevator then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local targetPart = getElevatorTargetPart(elevator)
                        if hrp and targetPart then
                            hrp.CFrame = targetPart.CFrame * CFrame.new(0, 4, 0)
                            if hrp:IsA("BasePart") then
                                hrp.AssemblyLinearVelocity = Vector3.zero
                            end
                            Notify("Auto Elevator", "Teleported to elevator!", 4)
                        else
                            teleportedElevatorThisFloor = false
                        end
                    else
                        teleportedElevatorThisFloor = false
                    end
                end
            end
        end
    end)

    Workspace.ChildAdded:Connect(function()
        teleportedElevatorThisFloor = false
    end)

    CreateToggle(TabYou, "Auto Teleport to Elevator", false, function(state)
        autoElevatorEnabled = state
        teleportedElevatorThisFloor = false
        Notify("You", state and "Auto Elevator Enabled" or "Auto Elevator Disabled", 2.5)
    end)

    local currentGenIdx = 1
    CreateButton(TabYou, "Teleport to Next Generator / Valve", function()
        local activeGenerators = getActiveGeneratorList()

        if #activeGenerators == 0 then
            Notify("Teleport", "No active generators or valves left on the map!", 2.5)
            return
        end

        if currentGenIdx > #activeGenerators then currentGenIdx = 1 end
        local targetGen = activeGenerators[currentGenIdx]

        local targetPart = targetGen:IsA("Model") and (targetGen.PrimaryPart or targetGen:FindFirstChildWhichIsA("BasePart")) or targetGen
        local prompt = targetGen:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
            targetPart = prompt.Parent
        end

        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if targetPart and hrp then
            local spawnPos = targetPart.CFrame * CFrame.new(0, 2, -3.5)
            hrp.CFrame = CFrame.lookAt(spawnPos.Position, targetPart.Position)
            
            Notify("Teleport", "Teleported to Generator / Valve #" .. currentGenIdx .. " / " .. #activeGenerators, 2)
            currentGenIdx = currentGenIdx + 1
        end
    end)
end

