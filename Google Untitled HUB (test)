    [15996720231] = true
}

local isBrookhaven = (game.PlaceId == BROOKHAVEN_PLACE_ID)
local isDandyWorld = DANDY_PLACE_IDS[game.PlaceId] or false

local function isGamePlace()
    if isBrookhaven then return true end
    if isDandyWorld then return true end
    if game.PlaceId == LOBBY_PLACE_ID then return false end
    local hasGenerators = Workspace:FindFirstChild("Generators") or Workspace:FindFirstChild("Machines") or Workspace:FindFirstChild("Rooms")
    local hasTwisteds = Workspace:FindFirstChild("Twisteds") or Workspace:FindFirstChild("Monsters")
    return (hasGenerators ~= nil or hasTwisteds ~= nil)
end

