local autoElevatorEnabled = false
local teleportedElevatorThisFloor = false

local function checkAllGeneratorsDone()
    local generators = getGeneratorList()
    local totalGens = #generators
    if totalGens == 0 then return 0, 0 end

    local completedGens = 0
    for _, gen in ipairs(generators) do
        if isGeneratorCompleted(gen) then
            completedGens = completedGens + 1
        end
    end

    return totalGens, completedGens
end

local function findElevatorObject()
    local bestElevator = nil
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "elevator") or string.find(nameLower, "lift") then
                local parentName = obj.Parent and string.lower(obj.Parent.Name) or ""
                if not (string.find(parentName, "elevator") or string.find(parentName, "lift")) then
                    if obj:IsA("Model") then
                        return obj
                    elseif not bestElevator then
                        bestElevator = obj
                    end
                end
            end
        end
    end
    return bestElevator
end

local function getElevatorTargetPart(elevator)
    if not elevator then return nil end
    if elevator:IsA("BasePart") then return elevator end
    
    if elevator.PrimaryPart then return elevator.PrimaryPart end
    
    local preferredNames = {"floor", "base", "platform", "center", "main", "door", "spawn"}
    for _, child in pairs(elevator:GetDescendants()) do
        if child:IsA("BasePart") then
            local cName = string.lower(child.Name)
            for _, pref in ipairs(preferredNames) do
                if string.find(cName, pref) then
                    return child
                end
            end
        end
    end
    
    return elevator:FindFirstChildWhichIsA("BasePart", true)
end

task.spawn(function()
    while task.wait(1) do
        if autoElevatorEnabled and not teleportedElevatorThisFloor then
            local total, completed = checkAllGeneratorsDone()
            if total > 0 and completed == total then
                teleportedElevatorThisFloor = true
                Notify("Auto Elevator", "All generators finished! Waiting 4s for elevator to load...", 4)
                
                task.wait(4)

                local elevator = findElevatorObject()
                
                if elevator then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local targetPart = getElevatorTargetPart(elevator)
                    if hrp and targetPart then
                        hrp.CFrame = targetPart.CFrame * CFrame.new(0, 4, 0)
                        if hrp:IsA("BasePart") then
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end
                        Notify("Auto Elevator", "Teleported to elevator!", 4)
