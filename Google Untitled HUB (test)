end

local validItemsList = {
    "research", "gumballs", "gumball", "chocolate", "stopwatch",
    "stamina candy", "stealth candy", "pop", "speed candy", "protein bar",
    "instructions", "extraction speed candy", "skill check candy", "jumper cable",
    "bandage", "air horn", "jawbreaker", "bonbon", "christmas cookie",
    "dandy easter egg", "bottle o' pop", "health kit", "medkit", "med kit",
    "box o' chocolates", "eject button", "smoke bomb", "valve", "ornaments",
    "baskets", "pumpkins", "candy", "candies", "gum"
}

local function isItemNameMatch(name)
    local nameLower = string.lower(name)
    for _, itemName in ipairs(validItemsList) do
        if string.find(nameLower, itemName, 1, true) then
            return true
        end
    end
    return false
end

local function isItemObject(obj)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    local nameLower = string.lower(obj.Name)
    if string.find(nameLower, "twisted") or string.find(nameLower, "monster") or string.find(nameLower, "elevator") or string.find(nameLower, "lift") then
        return false
    end
    if string.find(nameLower, "capsule") or string.find(nameLower, "ichor") or string.find(nameLower, "tape") then
        return false
    end

    local parentObj = obj.Parent
    while parentObj and parentObj ~= Workspace do
        local pName = string.lower(parentObj.Name)
        if (string.find(pName, "generator") or string.find(pName, "machine")) and not string.find(pName, "item") then
            return false
        end
        parentObj = parentObj.Parent
    end

    if isItemNameMatch(obj.Name) then
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and isItemNameMatch(obj.Parent.Name) then
            return false
        end
        return true
    end

    return false
end

local function isCapsuleObject(obj)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    
    local nameLower = string.lower(obj.Name)
    if not (string.find(nameLower, "capsule") or string.find(nameLower, "ichor")) then
        return false
    end
    if string.find(nameLower, "fake") or string.find(nameLower, "puddle") or string.find(nameLower, "stain") or string.find(nameLower, "decor") then
        return false
    end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return false end

    local current = obj.Parent
    while current and current ~= Workspace do
        local cName = string.lower(current.Name)
        if string.find(cName, "generator") or string.find(cName, "machine") or string.find(cName, "elevator") then
            return false
        end
        current = current.Parent
    end

    return true
end

local function isTapeObject(obj)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    local nameLower = string.lower(obj.Name)
    if not string.find(nameLower, "tape") or string.find(nameLower, "fake") then
        return false
    end
    if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and string.find(string.lower(obj.Parent.Name), "tape") then
        return false
    end
    return true
end

