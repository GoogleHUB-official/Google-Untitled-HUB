-- Dock Dragging Feature
local isDraggingDock = false
local dragStartDock = Vector2.zero
local startPosDock = UDim2.new()

DockMain.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingDock = true
        dragStartDock = input.Position
        startPosDock = DockBorder.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingDock and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartDock
        DockBorder.Position = UDim2.new(startPosDock.X.Scale, startPosDock.X.Offset + delta.X, startPosDock.Y.Scale, startPosDock.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingDock = false
    end
end)
