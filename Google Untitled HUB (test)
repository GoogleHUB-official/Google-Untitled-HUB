local espHighlights = {}
local espStates = {
    Twisteds = false,
    Generators = false,
    Items = false,
    Tapes = false,
    Ichor = false,
    Players = false
}

local function applyESP(object, name, color)
    if not object or (not object:IsA("Model") and not object:IsA("BasePart")) then return end
    if espHighlights[object] then return end

    local hl = Instance.new("Highlight")
    hl.Name = "DandyESP_" .. name
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    pcall(function() hl.Parent = object end)

    espHighlights[object] = hl
end

local function clearESPGroup(groupTag)
    for obj, hl in pairs(espHighlights) do
        if hl and hl.Name == "DandyESP_" .. groupTag then
            pcall(function() hl:Destroy() end)
            espHighlights[obj] = nil
        end
    end
end

local function updateESPLogic()
    for obj, hl in pairs(espHighlights) do
        if not obj or not obj.Parent or not hl or not hl.Parent then
            if hl and hl.Parent then pcall(function() hl:Destroy() end) end
            espHighlights[obj] = nil
        end
    end

    if espStates.Twisteds then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local nameLower = string.lower(obj.Name)
                if (string.find(nameLower, "twisted") or string.find(nameLower, "monster")) and not espHighlights[obj] then
                    applyESP(obj, "Twisteds", Color3.fromRGB(234, 67, 53))
                end
            end
        end
    else
        clearESPGroup("Twisteds")
    end

    if espStates.Generators then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if isGeneratorObject(obj) then
                if isGeneratorCompleted(obj) then
                    if espHighlights[obj] then
                        pcall(function() espHighlights[obj]:Destroy() end)
                        espHighlights[obj] = nil
                    end
                else
                    if not espHighlights[obj] then
                        applyESP(obj, "Generators", Color3.fromRGB(66, 133, 244))
                    end
                end
            end
        end
    else
        clearESPGroup("Generators")
    end

    if espStates.Items then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if isItemObject(obj) and not espHighlights[obj] then
                applyESP(obj, "Items", Color3.fromRGB(52, 168, 83))
            end
        end
    else
        clearESPGroup("Items")
    end

    if espStates.Tapes then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if isTapeObject(obj) and not espHighlights[obj] then
                applyESP(obj, "Tapes", Color3.fromRGB(0, 200, 255))
            end
        end
    else
        clearESPGroup("Tapes")
    end

    if espStates.Ichor then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if isCapsuleObject(obj) and not espHighlights[obj] then
                applyESP(obj, "Ichor", Color3.fromRGB(251, 188, 5))
            end
        end
    else
        clearESPGroup("Ichor")
    end

    if espStates.Players then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not espHighlights[player.Character] then
                applyESP(player.Character, "Players", Color3.fromRGB(255, 140, 0))
            end
        end
    else
        clearESPGroup("Players")
    end
end

