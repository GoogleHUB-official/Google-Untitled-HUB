    }):Play()

    local isDragging = false
    local dragStart = Vector2.zero
    local startYOffset = 0

    Card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStart = input.Position
            startYOffset = Card.Position.Y.Offset
        end
    end)

    Card.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local deltaY = input.Position.Y - dragStart.Y
            Card.Position = UDim2.new(0, 0, 0, startYOffset + deltaY)
        end
    end)

    local function releaseSpring()
        if isDragging then
            isDragging = false
            TweenService:Create(Card, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 0, 0, 0)
            }):Play()
        end
    end

    Card.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            releaseSpring()
        end
    end)

    local notifyConn
    notifyConn = RunService.RenderStepped:Connect(function()
        StrokeGradient.Rotation = (StrokeGradient.Rotation + 2) % 360
        Logo.Rotation = (Logo.Rotation + 2) % 360
    end)

    TweenService:Create(ProgressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)}):Play()

    task.delay(duration, function()
        if notifyConn then notifyConn:Disconnect() end
        local fade = TweenService:Create(Card, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 340, 0, 0),
            Size = UDim2.new(0.6, 0, 0, 72),
            BackgroundTransparency = 1
        })
        fade:Play()
        fade.Completed:Connect(function() Card:Destroy() end)
    end)
end

