local function isGeneratorObject(obj)
    if not obj then return false end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    local nameLower = string.lower(obj.Name)
    local isGenName = string.find(nameLower, "generator") or string.find(nameLower, "machine") or string.find(nameLower, "inchor") or string.find(nameLower, "ichor") or string.find(nameLower, "valve")
    
    if not isGenName and obj.Parent then
        local pName = string.lower(obj.Parent.Name)
        if (pName == "generators" or pName == "machines" or pName == "anchors" or pName == "inchors") and obj:IsA("Model") then
            isGenName = true
        end
    end
    
    if not isGenName then return false end

    local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
    local hasProgress = obj:FindFirstChild("Progress", true) ~= nil or obj:FindFirstChild("Completed", true) ~= nil or obj:FindFirstChild("IsCompleted", true) ~= nil or obj:FindFirstChild("Done", true) ~= nil

    if not (hasPrompt or hasProgress) then
        return false
    end

    if obj:IsA("Model") then
        if obj.Parent and obj.Parent:IsA("Model") then
            local pName = string.lower(obj.Parent.Name)
            if string.find(pName, "generator") or string.find(pName, "machine") or string.find(pName, "inchor") or string.find(pName, "ichor") then
                return false
            end
        end
        return true
    elseif obj:IsA("BasePart") then
        if not (obj.Parent and obj.Parent:IsA("Model")) then
            return true
        end
    end
    return false
end

local function isGeneratorCompleted(obj)
    if not obj then return true end

    local progressVal = obj:FindFirstChild("Progress", true)
    if progressVal and (progressVal:IsA("NumberValue") or progressVal:IsA("IntValue")) then
        return progressVal.Value >= 100 or progressVal.Value >= 1
    end

    local completedVal = obj:FindFirstChild("Completed", true) or obj:FindFirstChild("IsCompleted", true) or obj:FindFirstChild("Done", true)
    if completedVal then
        if completedVal:IsA("BoolValue") then
            return completedVal.Value == true
        elseif completedVal:IsA("StringValue") or completedVal:IsA("IntValue") or completedVal:IsA("NumberValue") then
            return tostring(completedVal.Value) == "true" or completedVal.Value == 1
        end
    end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        return not prompt.Enabled
    end

    return false
end

local function getGeneratorList()
    local list = {}
    local seen = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if isGeneratorObject(obj) and not seen[obj] then
