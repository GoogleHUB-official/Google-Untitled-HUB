local function CreateSlider(parentScroll, text, minVal, maxVal, defaultVal, callback)
    local baseZ = parentScroll.ZIndex + 1
    local currentValue = math.clamp(defaultVal or minVal, minVal, maxVal)

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -6, 0, 42)
    container.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    container.ZIndex = baseZ
    container.Parent = parentScroll

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = container

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(50, 50, 65)
    stroke.Parent = container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 18)
    label.Position = UDim2.new(0, 10, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(230, 230, 240)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = baseZ + 1
    label.Parent = container

    local valText = Instance.new("TextLabel")
    valText.Size = UDim2.new(0.35, -10, 0, 18)
    valText.Position = UDim2.new(0.65, 0, 0, 4)
    valText.BackgroundTransparency = 1
    valText.Text = tostring(currentValue)
    valText.TextColor3 = Color3.fromRGB(66, 133, 244)
    valText.Font = Enum.Font.GothamBold
    valText.TextSize = 11
    valText.TextXAlignment = Enum.TextXAlignment.Right
    valText.ZIndex = baseZ + 1
    valText.Parent = container

    local sliderBar = Instance.new("Frame")
    sliderBar.Size = UDim2.new(1, -20, 0, 6)
    sliderBar.Position = UDim2.new(0, 10, 1, -12)
    sliderBar.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
    sliderBar.BorderSizePixel = 0
    sliderBar.ZIndex = baseZ + 1
    sliderBar.Parent = container

    local fillBar = Instance.new("Frame")
    fillBar.Size = UDim2.new((currentValue - minVal) / (maxVal - minVal), 0, 1, 0)
    fillBar.BackgroundColor3 = Color3.fromRGB(66, 133, 244)
    fillBar.BorderSizePixel = 0
    fillBar.ZIndex = baseZ + 2
    fillBar.Parent = sliderBar

    local isDragging = false

    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
        currentValue = math.floor(minVal + (maxVal - minVal) * pos)
        valText.Text = tostring(currentValue)
        fillBar.Size = UDim2.new(pos, 0, 1, 0)
        if callback then callback(currentValue) end
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            updateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    return container
end

