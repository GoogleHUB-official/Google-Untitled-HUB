local function isGeneratorObject(obj)
    if not obj then return false end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    local nameLower = string.lower(obj.Name)
    local isGenName = string.find(nameLower, "generator") or string.find(nameLower, "machine") or string.find(nameLower, "inchor") or string.find(nameLower, "ichor") or string.find(nameLower, "valve")
    
    if not isGenName and obj.Parent then
        local pName = string.lower(obj.Parent.Name)
        if (pName == "generators" or pName == "machines" or pName == "anchors" or pName == "inchors") and obj:IsA("Model") then
            isGenName = true
        end
    end
    
    if not isGenName then return false end

    -- Проверка на валидный генератор/клапан: наличие ProximityPrompt или индикатора выполнения
    local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
    local hasProgress = obj:FindFirstChild("Progress", true) ~= nil or obj:FindFirstChild("Completed", true) ~= nil or obj:FindFirstChild("IsCompleted", true) ~= nil or obj:FindFirstChild("Done", true) ~= nil

    if not (hasPrompt or hasProgress) then
        return false
    end

    if obj:IsA("Model") then
        if obj.Parent and obj.Parent:IsA("Model") then
            local pName = string.lower(obj.Parent.Name)
            if string.find(pName, "generator") or string.find(pName, "machine") or string.find(pName, "inchor") or string.find(pName, "ichor") then
                return false
            end
        end
        return true
    elseif obj:IsA("BasePart") then
        if not (obj.Parent and obj.Parent:IsA("Model")) then
            return true
        end
    end
    return false
end

local function isGeneratorCompleted(obj)
    if not obj then return true end

    local progressVal = obj:FindFirstChild("Progress", true)
    if progressVal and (progressVal:IsA("NumberValue") or progressVal:IsA("IntValue")) then
        return progressVal.Value >= 100 or progressVal.Value >= 1
    end

    local completedVal = obj:FindFirstChild("Completed", true) or obj:FindFirstChild("IsCompleted", true) or obj:FindFirstChild("Done", true)
    if completedVal then
        if completedVal:IsA("BoolValue") then
            return completedVal.Value == true
        elseif completedVal:IsA("StringValue") or completedVal:IsA("IntValue") or completedVal:IsA("NumberValue") then
            return tostring(completedVal.Value) == "true" or completedVal.Value == 1
        end
    end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        return not prompt.Enabled
    end

    return false
end

local function getGeneratorList()
    local list = {}
    local seen = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if isGeneratorObject(obj) and not seen[obj] then
            seen[obj] = true
            table.insert(list, obj)
        end
    end
    return list
end

local function getActiveGeneratorList()
    local list = {}
    local seen = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if isGeneratorObject(obj) and not isGeneratorCompleted(obj) and not seen[obj] then
            seen[obj] = true
            table.insert(list, obj)
        end
    end
    return list
end

local validItemsList = {
    "research", "gumballs", "gumball", "chocolate", "stopwatch",
    "stamina candy", "stealth candy", "pop", "speed candy", "protein bar",
    "instructions", "extraction speed candy", "skill check candy", "jumper cable",
    "bandage", "air horn", "jawbreaker", "bonbon", "christmas cookie",
    "dandy easter egg", "bottle o' pop", "health kit", "medkit", "med kit",
    "box o' chocolates", "eject button", "smoke bomb", "valve", "ornaments",
    "baskets", "pumpkins", "candy", "candies", "gum"
}

local function isItemNameMatch(name)
    local nameLower = string.lower(name)
    for _, itemName in ipairs(validItemsList) do
        if string.find(nameLower, itemName, 1, true) then
            return true
        end
    end
    return false
end

local function isItemObject(obj)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

    local nameLower = string.lower(obj.Name)
    if string.find(nameLower, "twisted") or string.find(nameLower, "monster") or string.find(nameLower, "elevator") or string.find(nameLower, "lift") then
        return false
    end
    if string.find(nameLower, "capsule") or string.find(nameLower, "ichor") or string.find(nameLower, "tape") then
        return false
    end

    local parentObj = obj.Parent
    while parentObj and parentObj ~= Workspace do
        local pName = string.lower(parentObj.Name)
        if (string.find(pName, "generator") or string.find(pName, "machine")) and not string.find(pName, "item") then
            return false
        end
        parentObj = parentObj.Parent
    end

    if isItemNameMatch(obj.Name) then
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and isItemNameMatch(obj.Parent.Name) then
            return false
        end
        return true
    end

    return false
end

local function isCapsuleObject(obj)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    
    local nameLower = string.lower(obj.Name)
    if not (string.find(nameLower, "capsule") or string.find(nameLower, "ichor")) then
        return false
    end
    if string.find(nameLower, "fake") or string.find(nameLower, "puddle") or string.find(nameLower, "stain") or string.find(nameLower, "decor") then
        return false
    end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return false end

    local current = obj.Parent
    while current and current ~= Workspace do
        local cName = string.lower(current.Name)
        if string.find(cName, "generator") or string.find(cName, "machine") or string.find(cName, "elevator") then
            return false
        end
        current = current.Parent
    end

    return true
end

local function isTapeObject(obj)
    if not obj or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    local nameLower = string.lower(obj.Name)
    if not string.find(nameLower, "tape") or string.find(nameLower, "fake") then
        return false
    end
    if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and string.find(string.lower(obj.Parent.Name), "tape") then
        return false
    end
    return true
end

