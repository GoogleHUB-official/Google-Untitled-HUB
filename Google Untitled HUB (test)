local function isGamePlace()
    if game.PlaceId == LOBBY_PLACE_ID then
        return false
    end
    local hasGenerators = Workspace:FindFirstChild("Generators") or Workspace:FindFirstChild("Machines") or Workspace:FindFirstChild("Rooms")
    local hasTwisteds = Workspace:FindFirstChild("Twisteds") or Workspace:FindFirstChild("Monsters")
    return (hasGenerators ~= nil or hasTwisteds ~= nil or game.PlaceId ~= LOBBY_PLACE_ID)
end

