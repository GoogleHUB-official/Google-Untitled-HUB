    isOpen = not isOpen
    playSFX(SFX_NORMAL, 0.6)

    if idleConnection then
        idleConnection:Disconnect()
        idleConnection = nil
    end

    currentRotation = currentRotation + 360

    if isOpen then
        TweenService:Create(DockBorder, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -190, 0.93, -27)
